{
  "info": {
    "_postman_id": "web-spp-flagship-pro-collection",
    "name": "Web SPP Flagship Pro - RESTful API Documentation (Sanctum)",
    "description": "Dokumentasi RESTful API Aplikasi Pembayaran SPP Sekolah berbasis Laravel 11 & Laravel Sanctum untuk Ujian Akhir Semester (UAS). Dilengkapi fitur Multi-Bulan Batch Payment, Kalkulasi Tunggakan Dinamis, Kwitansi Terbilang, dan Rekapitulasi Laporan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearer_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Portal Mandiri Siswa (Public)",
      "item": [
        {
          "name": "Cek Tagihan & Riwayat Siswa (NISN)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/portal/siswa/0051234567",
              "host": ["{{base_url}}"],
              "path": ["portal", "siswa", "0051234567"]
            },
            "description": "Endpoint publik untuk siswa & wali murid mengecek profil, tarif SPP, status lunas/tunggakan, dan riwayat kwitansi secara mandiri menggunakan 10 digit NISN tanpa memerlukan login token."
          }
        }
      ]
    },
